    {"phrase": "board of trustees", "kinds": ["role", "membership"]},
    {"phrase": "board of directors", "kinds": ["role", "membership"]},
    {"phrase": "employed by", "kinds": ["membership"]},
    {"phrase": "faculty of", "kinds": ["membership"]},
    {"phrase": "funded by", "kinds": ["funding"]},
    {"phrase": "grant from", "kinds": ["funding"]},
    {"phrase": "sponsored by", "kinds": ["funding", "partnership"]},
    {"phrase": "in partnership with", "kinds": ["partnership"]},
