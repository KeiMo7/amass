    {"phrase": "part of the", "kinds": ["org_structure"]},
    {"phrase": "a member of the", "kinds": ["org_structure", "membership"]},
    {"phrase": "a campus of", "kinds": ["org_structure"]},
    {"phrase": "a branch of", "kinds": ["org_structure"]},
    {"phrase": "parent company", "kinds": ["org_structure"]},
    {"phrase": "owned by", "kinds": ["org_structure"]},
    {"phrase": "operated by", "kinds": ["org_structure", "supplier"]},
    {"phrase": "managed by", "kinds": ["org_structure", "supplier"]},
    {"phrase": "on behalf of", "kinds": ["org_structure", "supplier"]},
    {"phrase": "director of", "kinds": ["role"]},
    {"phrase": "president of", "kinds": ["role"]},
    {"phrase": "chief information officer", "kinds": ["role"]},
    {"phrase": "chief information security officer", "kinds": ["role"]},
    {"phrase": "chief executive officer", "kinds": ["role"]},
